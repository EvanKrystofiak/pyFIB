
* { font-size: 12px; }

QMainWindow, QWidget { background: #232833; color: #e7ebf2; }

QMenuBar { background: #232833; color: #e7ebf2; border-bottom: 1px solid #3a4150; }
QMenuBar::item { padding: 5px 10px; background: transparent; }
QMenuBar::item:selected { background: #2b313d; border-radius: 4px; }
QMenu { background: #2b313d; color: #e7ebf2; border: 1px solid #3a4150; }
QMenu::item { padding: 6px 22px; }
QMenu::item:selected { background: #17c3b2; color: #06231f; }

QDockWidget { titlebar-close-icon: none; }
QDockWidget::title {
    background: #2b313d; padding: 7px 10px;
    border: 1px solid #3a4150; border-bottom: none;
    font-weight: 600; letter-spacing: 0.3px;
}
QDockWidget > QWidget { border: 1px solid #3a4150; }

QGroupBox {
    border: 1px solid #3a4150; border-radius: 8px; margin-top: 10px;
    padding: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #9aa3b2;
}

QLabel { background: transparent; }

/* prominent action buttons: give them objectName("toolButton") */
QToolButton#toolButton, QPushButton#toolButton {
    background: #1c212b; color: #e7ebf2;
    border: 1px solid #3a4150; border-radius: 8px;
    padding: 8px 12px; text-align: left; font-size: 13px;
}
QToolButton#toolButton:hover, QPushButton#toolButton:hover { border-color: #17c3b2; }
QToolButton#toolButton:checked, QPushButton#toolButton:checked {
    background: #17c3b2; color: #06231f; border-color: #3ad9c7;
    font-weight: 700;
}

/* generic buttons */
QToolButton, QPushButton {
    background: #1c212b; color: #e7ebf2;
    border: 1px solid #3a4150; border-radius: 6px; padding: 5px 10px;
}
QToolButton:hover, QPushButton:hover { border-color: #17c3b2; }
QToolButton:checked, QPushButton:checked {
    background: #17c3b2; color: #06231f; border-color: #3ad9c7;
}
QPushButton:disabled, QToolButton:disabled { color: #9aa3b2; border-color: #3a4150; }

QLineEdit, QComboBox, QDoubleSpinBox, QSpinBox, QPlainTextEdit, QTextEdit, QAbstractSpinBox {
    background: #1c212b; color: #e7ebf2;
    border: 1px solid #3a4150; border-radius: 6px; padding: 4px 6px;
    selection-background-color: #17c3b2; selection-color: #06231f;
}
QComboBox:hover, QLineEdit:hover, QDoubleSpinBox:hover, QSpinBox:hover { border-color: #17c3b2; }
QComboBox QAbstractItemView {
    background: #2b313d; color: #e7ebf2;
    border: 1px solid #3a4150; selection-background-color: #17c3b2;
    selection-color: #06231f;
}

QCheckBox, QRadioButton { spacing: 7px; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px; height: 16px; border: 1px solid #3a4150;
    border-radius: 4px; background: #1c212b;
}
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #17c3b2; border-color: #3ad9c7;
}

QProgressBar {
    border: 1px solid #3a4150; border-radius: 6px; text-align: center;
    background: #1c212b; color: #e7ebf2;
}
QProgressBar::chunk { background: #17c3b2; border-radius: 5px; }

QTabBar::tab {
    background: #1c212b; color: #9aa3b2;
    border: 1px solid #3a4150; padding: 6px 12px;
    border-top-left-radius: 6px; border-top-right-radius: 6px;
}
QTabBar::tab:selected { background: #2b313d; color: #e7ebf2; }

QStatusBar { background: #2b313d; color: #9aa3b2; border-top: 1px solid #3a4150; }
QStatusBar QLabel { color: #9aa3b2; }

QScrollBar:vertical { background: #232833; width: 11px; margin: 0; }
QScrollBar::handle:vertical { background: #3a4150; border-radius: 5px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #17c3b2; }
QScrollBar:horizontal { background: #232833; height: 11px; margin: 0; }
QScrollBar::handle:horizontal { background: #3a4150; border-radius: 5px; min-width: 24px; }
QScrollBar::handle:horizontal:hover { background: #17c3b2; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
